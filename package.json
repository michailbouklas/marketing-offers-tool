  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prisma:merchant-scrapes:generate": "prisma generate --config=prisma/merchant-scrapes/prisma.config.ts",
    "prisma:merchant-scrapes:validate": "prisma validate --config=prisma/merchant-scrapes/prisma.config.ts",
    "mastra:dev": "mastra dev --dir src/lib/server/mastra --env .env",
    "svelte-autofixer": "prettier --write .",
    "test": "vitest run",
    "digest": "vite-node --config vite.config.script.ts scripts/run-digest.ts --"
  },
