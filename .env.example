DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DATABASE="default"
CLICKHOUSE_USERNAME="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_REQUEST_TIMEOUT_MS="30000"
CLICKHOUSE_TRANSACTION_LOOKBACK_DAYS="90"
CLICKHOUSE_MISSING_OFFERS_SINCE="2024-01-01"
HOST="0.0.0.0"
PORT="3000"
ORIGIN="http://localhost:3000"

BETTER_AUTH_SECRET="your-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:5173"
# Use HTTPS values for any shared or network deployment that handles passwords.
# Comma-separated list of additional trusted origins (add your network HTTPS origin here when deployed behind TLS)
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5178"

# --- Image Generator ---
# Providers without an API key are hidden from the UI dropdown; missing keys
# only log a warning at boot, they do not crash the server.
IMAGE_ROUTER_API_KEY=""
IMAGE_ROUTER_BASE_URL="https://api.imagerouter.io"
IMAGE_ROUTER_MODELS="openai/gpt-image-1,google/nano-banana-2"
OPENAI_API_KEY=""
OPENAI_IMAGE_MODELS="gpt-image-1"
# Default provider chosen in the UI when both providers are configured.
DEFAULT_PROVIDER="imagerouter"
DEFAULT_MODEL="gpt-image-1"
# Filesystem location for generated images and uploaded references.
# In production this must point at a persistent volume mount.
UPLOADS_DIR="./uploads"
# Upper bound for the per-model sample count in the "All Models" flow.
SAMPLES_PER_MODEL_MAX="5"

# --- Competition scraper ---
# Remote scraper base URL. Protocol is optional and defaults to http:// when omitted.
REMOTE_SCRAPER_URL="http://localhost:3516"
