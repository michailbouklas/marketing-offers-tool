DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"
MERCHANT_SCRAPES_DATABASE_URL="postgresql://user:password@localhost:5432/merchant_scrapes?schema=public"
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_DATABASE="default"
CLICKHOUSE_USERNAME="default"
CLICKHOUSE_PASSWORD=""
CLICKHOUSE_REQUEST_TIMEOUT_MS="30000"
CLICKHOUSE_TRANSACTION_LOOKBACK_DAYS="90"
CLICKHOUSE_MISSING_OFFERS_SINCE="2024-01-01"
HOST="0.0.0.0"
PORT="3000"
ORIGIN="http://localhost:3000"

BETTER_AUTH_SECRET="your-secret-key-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:5173"
# Use HTTPS values for any shared or network deployment that handles passwords.
# Comma-separated list of additional trusted origins (add your network HTTPS origin here when deployed behind TLS)
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5178"

# --- Image Generator ---
# Providers without an API key are hidden from the UI dropdown; missing keys
# only log a warning at boot, they do not crash the server.
IMAGE_ROUTER_API_KEY=""
IMAGE_ROUTER_BASE_URL="https://api.imagerouter.io"
IMAGE_ROUTER_MODELS="openai/gpt-image-1,google/nano-banana-2"
OPENAI_API_KEY=""
OPENAI_IMAGE_MODELS="gpt-image-1"
# Default provider chosen in the UI when both providers are configured.
DEFAULT_PROVIDER="imagerouter"
DEFAULT_MODEL="gpt-image-1"
# Filesystem location for generated images and uploaded references.
# In production this must point at a persistent volume mount.
UPLOADS_DIR="./uploads"
# Upper bound for the per-model sample count in the "All Models" flow.
SAMPLES_PER_MODEL_MAX="5"

# --- Competition scraper ---
# Remote scraper base URL. Protocol is optional and defaults to http:// when omitted.
REMOTE_SCRAPER_URL="http://localhost:3516"

# --- Open WebUI bridge ---
# See docs/openwebui-integration.md. Empty secret = bridge disabled (503).
# Long random string. Open WebUI sends it as "Authorization: Bearer <secret>"
# (model connection / global tool server) and it is also the HMAC key for the
# per-user tokens minted by `bun scripts/openwebui-token.ts --email <user>`.
OPENWEBUI_SHARED_SECRET=""
# Headers Open WebUI forwards (ENABLE_FORWARD_USER_INFO_HEADERS=True or custom
# per-connection headers with {{USER_EMAIL}} / {{CHAT_ID}} / {{TASK}}).
OPENWEBUI_USER_EMAIL_HEADER="x-openwebui-user-email"
OPENWEBUI_CHAT_ID_HEADER="x-openwebui-chat-id"
OPENWEBUI_TASK_HEADER="x-openwebui-task"
# Comma-separated Open WebUI origins allowed to call the tool server from the
# browser (user-level "Settings -> Integrations" registration). Empty = no CORS.
OPENWEBUI_ORIGIN=""
# Wall-clock budget for one tool-server question (agent + SQL), in ms.
OPENWEBUI_ASK_TIMEOUT_MS="90000"
# Optional public base URL for the OpenAPI document's servers[].url (defaults to ORIGIN).
PUBLIC_BASE_URL=""

# --- Sales forecasts (Python sidecar, see docs/forecast-service.md) ---
# Base URL of the forecast service. docker-compose sets http://forecast:8000 for the app container.
FORECAST_SERVICE_URL="http://localhost:8000"
# Long random shared secret; SvelteKit sends it as "Authorization: Bearer <token>".
# Empty is only allowed together with FORECAST_ALLOW_NO_AUTH=1 (local dev).
FORECAST_SERVICE_TOKEN=""
FORECAST_ALLOW_NO_AUTH="0"
# Node-side wall-clock budget per model call, in ms. Keep it above FORECAST_TIMEOUT_S * 1000.
FORECAST_TIMEOUT_MS="75000"
# Days of ClickHouse history sent to the engine (default ~3 years).
FORECAST_HISTORY_DAYS="1095"
# Server-side caches: forecast results (also keyed by the latest sales date) and the model catalog.
FORECAST_CACHE_TTL_MS="21600000"
FORECAST_MODELS_TTL_MS="600000"
# ISO country for holiday effects (CY or GR).
FORECAST_DEFAULT_COUNTRY="CY"
# Python service: parallel model workers, per-request timeout (s), max queued+running requests before 429.
FORECAST_WORKERS="3"
FORECAST_TIMEOUT_S="60"
FORECAST_MAX_INFLIGHT="6"
# TimesFM 2.5 foundation model ("Foundation (TimesFM)" card). Off locally: needs the `foundation`
# extra (`bun run forecast:setup:foundation`, ~1.7 GB incl. the checkpoint) and ~1.3 GB RAM.
# docker-compose enables it. FORECAST_FOUNDATION_THREADS = torch threads in its dedicated worker.
FORECAST_FOUNDATION_ENABLED="0"
FORECAST_FOUNDATION_THREADS="4"
FORECAST_FOUNDATION_MAX_CONTEXT="1024"
# ClickHouse database holding transactions / transaction_details (also read by the sales agent).
CLICKHOUSE_SALES_DATABASE="default"
