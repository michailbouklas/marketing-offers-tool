generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model api_WOLT_header {
  id               Int              @id @default(autoincrement())
  documentid       String           @unique
  documentdate     DateTime?
  invoicenumber    String?
  timeframe        String?
  remarks          String?
  bpcode           String?
  bpname           String?
  partnername      String?
  distributionrule String?
  project          String?
  erpdatabase      String?
  createdat        DateTime         @default(now())
  erpsent          String?          @default("N")
  erpcreatedat     DateTime?
  totalpayout      Decimal?         @db.Decimal(19, 6)
  api_WOLT_lines   api_WOLT_lines[]
}

model api_WOLT_lines {
  documentid      String
  linenumber      Int
  transtype       String?
  linedetails     String?
  amount          Decimal?        @db.Decimal(19, 6)
  vatamount       Decimal?        @db.Decimal(19, 6)
  totalamount     Decimal?        @db.Decimal(19, 6)
  accountcode     String?
  vatcode         String?
  api_WOLT_header api_WOLT_header @relation(fields: [documentid], references: [documentid], onDelete: Cascade)

  @@id([documentid, linenumber])
}

model error_log {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  level     String
  message   String
  details   Json?
  source    String?
}

model brand {
  id                Int                           @id @default(autoincrement())
  name              String                        @db.Text
  alias             String                        @default("") @db.Text
  logo              String                        @default("") @db.Text
  slug              String                        @default("") @db.Text
  created_at        DateTime                      @default(now()) @db.Timestamp(3)
  updated_at        DateTime                      @db.Timestamp(3)
  description       String?                       @default("") @db.Text
  active            Boolean                       @default(true)
  sap_brand_alias   String?                       @db.Text
  sap_company_name  String?                       @db.Text
  aggregator_offers aggregator_offers[]
  user_assignments  user_brand[]
  brand_assets      BrandAsset[]
  generated_images  GeneratedImage[]
  generated_copies  GeneratedCopy[]
  image_templates   ImageGeneratorTemplateBrand[]
  brand_entities    brand_entity[]
}

model user_brand {
  userId    String
  brandId   Int
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand     brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([userId, brandId])
  @@index([brandId])
}

model regex_patterns_by_category {
  id       Int     @id @default(autoincrement())
  regex    String
  example  String?
  category String
}

model store_names {
  id              Int     @id @default(autoincrement())
  file_name       String? @db.VarChar
  pdf_name        String? @db.VarChar
  aggregator_name String? @db.VarChar
}

model wolt_regex_patters {
  id       Int     @id @default(autoincrement())
  regex    String
  example  String?
  category String
}

// Better Auth tables
model user {
  id                               String                              @id
  name                             String
  email                            String                              @unique
  emailVerified                    Boolean
  image                            String?
  role                             String?                             @default("user")
  banned                           Boolean?                            @default(false)
  banReason                        String?
  banExpires                       DateTime?
  createdAt                        DateTime
  updatedAt                        DateTime
  sessions                         session[]
  accounts                         account[]
  brand_assignments                user_brand[]
  dim_offers_audits                dim_offers_audit[]                  @relation("DimOffersAuditActor")
  generated_images                 GeneratedImage[]
  generated_copies                 GeneratedCopy[]
  image_presets                    ImageGeneratorPreset[]
  image_templates                  ImageGeneratorTemplate[]
  reference_images                 ReferenceImage[]
  competition_restaurant_prefs     competition_user_restaurant_pref[]
  competition_dashboard_widgets    competition_dashboard_widget[]
  google_reviews_business_prefs    google_reviews_user_business_pref[]
  google_reviews_dashboard_widgets google_reviews_dashboard_widget[]
  monitor_entries                  user_monitor[]
  urls_to_scrape                   urls_to_scrape[]
}

model session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model UserToken {
  id         Int           @id @default(autoincrement())
  token      String        @unique
  type       EnumTokenType
  userId     Int
  isValid    Boolean       @default(true)
  expiresAt  DateTime
  usedAt     DateTime?
  created_at DateTime      @default(now())
  updated_at DateTime

  @@index([expiresAt])
  @@index([isValid])
  @@index([token])
  @@index([type])
  @@index([userId])
}

model categories {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  subcategories subcategories[]
}

model channels {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model dq_missing_offers_pricing {
  dq_id           Int                  @id @default(autoincrement())
  trde_item       String               @db.VarChar
  item_name       String               @db.VarChar
  brand           String               @db.VarChar
  item_category   String               @db.VarChar
  missing_fields  String               @db.VarChar
  detected_at     DateTime             @default(now())
  status          DqGapStatus          @default(open)
  resolved_at     DateTime?
  audit_records   dim_offers_audit[]
  staging_records dim_offers_staging[]

  @@index([status])
  @@index([trde_item])
}

model dim_offers_staging {
  id            Int                       @id @default(autoincrement())
  dq_id         Int
  item_code     String                    @db.VarChar
  channel       String                    @db.VarChar
  category      String                    @db.VarChar
  subcategory   String                    @db.VarChar
  ideal_price   Decimal                   @db.Decimal(10, 2)
  selling_price Decimal                   @db.Decimal(10, 2)
  fc_perc       Decimal                   @db.Decimal(5, 4)
  mktg_spend    Decimal?                  @db.Decimal(10, 2)
  notes         String?                   @db.VarChar(500)
  submitted_by  String                    @db.VarChar
  submitted_at  DateTime                  @default(now())
  approved_by   String?                   @db.VarChar
  approved_at   DateTime?
  status        DimOffersStagingStatus    @default(pending)
  audit_records dim_offers_audit[]
  gap_record    dq_missing_offers_pricing @relation(fields: [dq_id], references: [dq_id], onDelete: Restrict)

  @@index([dq_id])
  @@index([item_code])
  @@index([status])
}

model dim_offers_audit {
  id             Int                        @id @default(autoincrement())
  item_code      String                     @db.VarChar
  action         DimOffersAuditAction
  source         DimOffersAuditSource       @default(gap_approval)
  changed_by     String                     @db.VarChar
  changed_at     DateTime                   @default(now())
  staging_id     Int?
  dq_id          Int?
  before_values  Json?
  after_values   Json
  changed_fields String[]
  actor          user?                      @relation("DimOffersAuditActor", fields: [changed_by], references: [id], onDelete: Restrict)
  staging_record dim_offers_staging?        @relation(fields: [staging_id], references: [id], onDelete: SetNull)
  gap_record     dq_missing_offers_pricing? @relation(fields: [dq_id], references: [dq_id], onDelete: SetNull)

  @@index([item_code])
  @@index([changed_by])
  @@index([changed_at])
  @@index([staging_id])
  @@index([dq_id])
}

model subcategories {
  id          Int        @id @default(autoincrement())
  category_id Int
  name        String
  category    categories @relation(fields: [category_id], references: [id])

  @@unique([category_id, name])
}

enum Aggregator {
  foody
  bolt
  wolt
  efood
}

model urls_to_scrape {
  id         Int        @id @default(autoincrement())
  url        String
  aggregator Aggregator
  userId     String
  user       user       @relation(fields: [userId], references: [id])
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@index([userId])
}

enum DqGapStatus {
  open
  submitted
  resolved
}

enum DimOffersStagingStatus {
  pending
  approved
  rejected
}

enum DimOffersAuditAction {
  insert
  update
}

enum DimOffersAuditSource {
  gap_approval
}

model aggregator_offers {
  id                 Int        @id @default(autoincrement())
  name               String
  offer_id           String
  novasero_item_code String     @default("")
  aggregator         Aggregator
  brand_id           Int
  brand              brand      @relation(fields: [brand_id], references: [id])
  details            String     @db.Text
  starts_at          DateTime
  ends_at            DateTime
  active             Boolean    @default(true)
  created_at         DateTime   @default(now())
  updated_at         DateTime   @updatedAt

  @@index([brand_id])
}

model GeneratedImage {
  id               String               @id @default(cuid())
  userId           String
  user             user                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId          Int?
  brand            brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  prompt           String               @db.Text
  finalPrompt      String               @db.Text
  provider         String
  model            String?
  requestedWidth   Int
  requestedHeight  Int
  generationWidth  Int
  generationHeight Int
  style            String?
  camera           String?
  aspectRatio      String?
  negativePrompt   String?              @db.Text
  quality          String?
  background       String?
  inputFidelity    String?
  referenceIds     Json
  localPath        String?
  remoteUrl        String?              @db.Text
  status           GeneratedImageStatus
  errorMessage     String?              @db.Text
  durationMs       Int?
  createdAt        DateTime             @default(now())

  failureLogs GenerationFailureLog[]

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
}

// One row per failed provider attempt (including attempts that later succeed
// on retry). Keeps the full provider request snapshot and raw response so
// production failures can be investigated after the fact.
model GenerationFailureLog {
  id               String         @id @default(cuid())
  generatedImageId String
  generatedImage   GeneratedImage @relation(fields: [generatedImageId], references: [id], onDelete: Cascade)
  provider         String
  model            String?
  attempt          Int
  errorName        String
  errorMessage     String         @db.Text
  responseStatus   Int?
  responseBody     Json?
  requestSnapshot  Json?
  durationMs       Int?
  createdAt        DateTime       @default(now())

  @@index([createdAt])
  @@index([generatedImageId])
}

model BrandAsset {
  id          String   @id @default(cuid())
  brandId     Int
  brand       brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name        String
  displayName String?
  localPath   String
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([brandId, createdAt])
}

model ReferenceImage {
  id          String   @id @default(cuid())
  userId      String
  user        user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  localPath   String
  contentType String
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model ImageGeneratorPreset {
  id        String   @id @default(cuid())
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model ImageGeneratorTemplate {
  id         String                           @id @default(cuid())
  userId     String
  user       user                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  prompt     String                           @db.Text
  settings   Json
  visibility ImageGeneratorTemplateVisibility @default(private)
  brands     ImageGeneratorTemplateBrand[]
  createdAt  DateTime                         @default(now())
  updatedAt  DateTime                         @updatedAt

  @@unique([userId, name])
  @@index([visibility, updatedAt])
  @@index([userId, updatedAt])
}

model ImageGeneratorTemplateBrand {
  templateId String
  brandId    Int
  template   ImageGeneratorTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  brand      brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@id([templateId, brandId])
  @@index([brandId])
}

// One row per copywriting generation request. `variants` holds the bilingual
// (el/en) variant array whose shape depends on `copyType` — see
// src/lib/services/copywriter/types.ts for the contract.
model GeneratedCopy {
  id           String              @id @default(cuid())
  userId       String
  user         user                @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId      Int?
  brand        brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  // Offer the brief was pre-filled from, kept as a plain column (no FK) so
  // history survives offer deletion.
  offerId      Int?
  copyType     CopyType
  channel      String
  brief        String              @db.Text
  tone         String?
  finalPrompt  String              @db.Text
  provider     String
  model        String?
  variants     Json
  status       GeneratedCopyStatus
  errorMessage String?             @db.Text
  durationMs   Int?
  createdAt    DateTime            @default(now())

  failureLogs CopyGenerationFailureLog[]

  @@index([userId, createdAt])
  @@index([brandId, createdAt])
}

// One row per failed copy provider attempt (including attempts that later
// succeed on retry). Mirrors GenerationFailureLog for images.
model CopyGenerationFailureLog {
  id              String        @id @default(cuid())
  generatedCopyId String
  generatedCopy   GeneratedCopy @relation(fields: [generatedCopyId], references: [id], onDelete: Cascade)
  provider        String
  model           String?
  attempt         Int
  errorName       String
  errorMessage    String        @db.Text
  responseStatus  Int?
  responseBody    Json?
  requestSnapshot Json?
  durationMs      Int?
  createdAt       DateTime      @default(now())

  @@index([createdAt])
  @@index([generatedCopyId])
}

enum CopyType {
  aggregator_offer
  social_caption
  push_sms
  banner_headline
}

enum GeneratedCopyStatus {
  completed
  failed
}

enum GeneratedImageStatus {
  pending
  completed
  failed
}

enum ImageGeneratorTemplateVisibility {
  private
  public
}

model api_BOLT_header {
  id               Int              @default(autoincrement())
  documentid       String           @id(map: "PK_api_BOLT_header") @db.VarChar(100)
  documentdate     DateTime?        @db.Timestamp(6)
  invoicenumber    String?          @db.VarChar(254)
  timeframe        String?          @db.VarChar(100)
  scenario         Int              @default(1)
  je1_date         DateTime?        @db.Timestamp(6)
  je2_date         DateTime?        @db.Timestamp(6)
  bpcode           String?          @db.VarChar(50)
  bpname           String?          @db.VarChar(150)
  bolt_storename   String?          @db.VarChar(150)
  distributionrule String?          @db.VarChar(50)
  project          String?          @db.VarChar(50)
  erpdatabase      String?          @db.VarChar(100)
  totalpayout      Decimal?         @db.Decimal(19, 6)
  createdat        DateTime?        @default(now()) @db.Timestamp(6)
  erpsent          String?          @default("N") @db.VarChar
  erpcreatedat     DateTime?        @db.Timestamp(6)
  erpcomments      String?          @db.VarChar(254)
  api_BOLT_lines   api_BOLT_lines[]
}

model api_BOLT_lines {
  documentid      String          @db.VarChar(50)
  linenumber      Int
  je_number       Int             @default(1)
  transtype       String?         @db.VarChar(20)
  linedetails     String?         @db.VarChar(1000)
  amount          Decimal?        @db.Decimal(19, 6)
  vatamount       Decimal?        @db.Decimal(19, 6)
  totalamount     Decimal?        @db.Decimal(19, 6)
  accountcode     String?         @db.VarChar(50)
  vatcode         String?         @db.VarChar(20)
  api_BOLT_header api_BOLT_header @relation(fields: [documentid], references: [documentid], onUpdate: Cascade, onDelete: Cascade)

  @@id([documentid, je_number, linenumber], map: "PK_api_BOLT_lines")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model bolt_company_mappings {
  invoice_store_name String?
  bp_code            Float?
  bp_name            String?
  distribution_rule  String?
  cost_center        String?
  erpdatabase        String?

  @@ignore
}

model bolt_regex_patters {
  id          Int     @id @default(autoincrement())
  regex       String
  example     String?
  category    String
  accountcode Int?
  vatcode     String?
}

// --- Competition analytics (data lives in the competition-scraper ClickHouse
// replica; these tables only hold per-user state on top of it). Restaurants
// are referenced by the ClickHouse composite (processorId, restaurantId) —
// `restaurants.id` is the scraper's dedup key and what every child table FKs
// to, while `external_id` is only unique within a processor.

enum CompetitionTrackState {
  tracked
  ignored
}

model competition_user_restaurant_pref {
  id           String                @id @default(cuid())
  userId       String
  user         user                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  processorId  Int // ClickHouse aggregator.id
  restaurantId Int // ClickHouse restaurant.id
  state        CompetitionTrackState @default(tracked)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([userId, processorId, restaurantId])
  @@index([userId, state])
}

// Per-user dashboard layout for /competition. `widgetType` is a plain string
// (registry key validated in code) so adding phase-2 widgets needs no
// migration; `settings` holds widget-specific configuration.
model competition_dashboard_widget {
  id         String   @id @default(cuid())
  userId     String
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetType String
  position   Int
  settings   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, position])
}

// --- Google reviews analytics (data lives in the google-maps-scraper
// ClickHouse replica; these tables only hold per-user state on top of it).
// Businesses are referenced by the ClickHouse `businesses.cid` — Google's
// stable business identifier that every child table FKs to.

enum GoogleReviewsPrefState {
  monitored
  ignored
}

model google_reviews_user_business_pref {
  id          String                 @id @default(cuid())
  userId      String
  user        user                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessCid String // ClickHouse businesses.cid
  state       GoogleReviewsPrefState @default(monitored)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([userId, businessCid])
  @@index([userId, state])
}

// Per-user dashboard layout for /google-reviews. `widgetType` is a plain
// string (registry key validated in code) so adding phase-2 widgets needs no
// migration; `settings` holds widget-specific configuration.
model google_reviews_dashboard_widget {
  id         String   @id @default(cuid())
  userId     String
  user       user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  widgetType String
  position   Int
  settings   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, position])
}

// --- Cross-section monitor list (generic per-user "favorites"). `section`
// scopes the entry to a feature area and `entityId` is that section's stable
// identifier as a string: for `competition` it is the ClickHouse composite
// `"${processorId}:${restaurantId}"`; for `googleReviews` it is `businesses.cid`.
enum MonitorSection {
  competition
  googleReviews
}

model user_monitor {
  id        String         @id @default(cuid())
  userId    String
  user      user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   MonitorSection
  entityId  String
  createdAt DateTime       @default(now())

  @@unique([userId, section, entityId])
  @@index([userId, section])
}

// --- Offer-notification digest cursor (Part B consumer). Singleton row
// (`id` is always 1) tracking the highest `offer_notification_queue.id` already
// processed from the scraper Postgres. The digest job reads queue rows with
// `id > lastProcessedQueueId`, emails monitoring users, then advances this
// cursor. See `src/lib/services/notifications/`.
model notification_cursor {
  id                   Int      @id @default(1)
  lastProcessedQueueId BigInt   @default(0)
  updatedAt            DateTime @updatedAt
}

// --- Brand grouping of scraped entities. Administrators assign disjointed
// scraped entities (a competition restaurant, or a Google reviews business)
// to a `brand` so analytics can roll up across sections and aggregators.
// `entityId` is the section's stable identifier as a string, matching the
// `user_monitor` encoding: for `competitionRestaurant` it is the ClickHouse
// composite `"${processorId}:${restaurantId}"`; for `googleReviewsBusiness`
// it is `businesses.cid` (a numeric-looking string — never coerce to number).
// The `@@unique([entityType, entityId])` enforces that each entity belongs to
// at most one brand, so assigning is an upsert that moves the entity.
enum BrandEntityType {
  competitionRestaurant
  googleReviewsBusiness
}

enum EnumTokenType {
  ACTIVATION
  PASSWORD_RESET
}

model brand_entity {
  id         String          @id @default(cuid())
  brandId    Int
  brand      brand           @relation(fields: [brandId], references: [id], onDelete: Cascade)
  entityType BrandEntityType
  entityId   String
  createdBy  String? // user.id of the admin who made the assignment (audit)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([entityType, entityId])
  @@index([brandId])
}
