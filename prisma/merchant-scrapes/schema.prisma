generator client {
  provider = "prisma-client"
  output   = "../../src/generated/merchant-scrapes-prisma"
}

datasource db {
  provider = "postgresql"
}
enum Aggregator {
  FOODY
  WOLT
}

/// Mirrors SectionStatus in src/foody/types.ts ("ok"|"partial"|"failed"|"skipped").
enum SectionStatus {
  OK
  PARTIAL
  FAILED
  SKIPPED
}

/// Terminal outcome of a scrape session (one supervisor invocation). RUNNING is
/// the initial/in-flight state; a hard-killed session stays RUNNING with its
/// last-known counts until a later run reconciles it. See ScrapeRun.
enum ScrapeRunStatus {
  RUNNING
  COMPLETED
  INTERRUPTED
  SYSTEMIC_BREAKAGE
  CRASHED
}

/// One scrape *session* = one supervisor invocation (foody:scrape:start or
/// :fresh). Survives the supervisor's crash-restarts: the row is created
/// RUNNING at startup, updated in place after every child exit (so progress
/// survives a later hard-kill), and finalized with a terminal status on a clean
/// end. `sessionId` is supervisor-minted and stable across restarts; `runId` is
/// the child batch id (ties to ScrapeSnapshot.runId) and stays null until a
/// child has scraped something. Counts are a pure rollup of the run manifest.
model ScrapeRun {
  id         Int             @id @default(autoincrement())
  aggregator Aggregator      @default(FOODY)
  sessionId  String          @unique // supervisor-minted, e.g. "2026-07-08T09-06-51-584Z"
  runId      String? // child batch runId (ties to ScrapeSnapshot.runId); null if nothing scraped
  shard      String? // "2/3" | null
  argv       String[] // CLI args of the run (forensics)
  fresh      Boolean         @default(false) // was --fresh passed (full re-scrape) vs a resume
  startedAt  DateTime
  endedAt    DateTime?
  status     ScrapeRunStatus @default(RUNNING)
  restarts   Int             @default(0) // supervisor child restarts

  totalStores   Int?
  okStores      Int @default(0)
  partialStores Int @default(0)
  failedStores  Int @default(0)
  skippedStores Int @default(0)

  /// End-of-session per-section diagnosis (ManifestDiagnostics from
  /// src/foody/diagnostics.ts): per-section ok/partial/failed/skipped tallies +
  /// dominant missing fields/errors. Null for sessions finalized before this
  /// existed, or that scraped nothing.
  sectionDiagnostics Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aggregator, startedAt])
  @@index([runId])
}

/// One merchant store on one aggregator. Identity = (aggregator, externalId):
///   FOODY: full vendor id "FY_CY;493"
///   WOLT:  venue slug from the merchant URL, e.g. "pizza-hut-strovolos"
model Store {
  id         Int        @id @default(autoincrement())
  aggregator Aggregator
  externalId String
  slug       String? // result-file slug, e.g. "kfc-dali-493"
  name       String?
  url        String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  snapshots ScrapeSnapshot[]
  reviews   Review[]

  @@unique([aggregator, externalId])
  @@index([aggregator, name])
}

/// One scrape of one store at one point in time. Foody: periodStart/End null
/// (live "current" snapshot). Wolt: periodStart/End from the requested
/// "YYYY-MM-DD--YYYY-MM-DD" range.
model ScrapeSnapshot {
  id          Int       @id @default(autoincrement())
  storeId     Int
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  scrapedAt   DateTime
  runId       String?
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  sourceFile  String? // provenance, e.g. "data/foody-results/kfc-dali-493.json"
  raw         Json // entire source payload, verbatim
  createdAt   DateTime  @default(now())

  sections    SectionResult[]
  metrics     MetricsSnapshot?
  rating      RatingSnapshot?
  closures    ClosuresSnapshot?
  punctuality PunctualitySnapshot?
  rejections  OrderRejectionsSnapshot?

  @@unique([storeId, scrapedAt])
  @@index([scrapedAt])
  @@index([runId])
}

/// Per-section outcome bookkeeping. `key` is a free string ("metrics",
/// "rating", "reviews", "operations", future Wolt keys) — intentionally not
/// an enum so a new section never needs a migration.
model SectionResult {
  id            Int            @id @default(autoincrement())
  snapshotId    Int
  snapshot      ScrapeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  key           String
  status        SectionStatus
  error         String?
  missingFields String[]
  durationMs    Int?
  attempts      Int            @default(1) // times this section was extracted (>1 after a retry pass)

  @@unique([snapshotId, key])
  @@index([status])
}

/// Sales/order headline metrics (Foody "metrics" section; Wolt home + insights
/// KPIs). Delta* columns and comparisonWindow are Wolt-only for now.
model MetricsSnapshot {
  id         Int            @id @default(autoincrement())
  snapshotId Int            @unique
  snapshot   ScrapeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status     SectionStatus

  sales         Decimal? @db.Decimal(12, 2)
  orders        Int?
  avgBasketSize Decimal? @db.Decimal(10, 2)

  avgBasketItems  Decimal? @db.Decimal(8, 2)
  completedOrders Int?

  salesDeltaPct          Decimal? @db.Decimal(8, 2)
  ordersDeltaPct         Decimal? @db.Decimal(8, 2)
  avgBasketSizeDeltaPct  Decimal? @db.Decimal(8, 2)
  avgBasketItemsDeltaPct Decimal? @db.Decimal(8, 2)
  comparisonWindow       String? // e.g. "8w, 4d"
}

/// Store-rating snapshot. The star distribution is a child row table (not
/// 5+5 columns) so a different scale needs no migration and missing buckets
/// are absent rows rather than ambiguous nulls.
model RatingSnapshot {
  id           Int            @id @default(autoincrement())
  snapshotId   Int            @unique
  snapshot     ScrapeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status       SectionStatus
  storeRating  Decimal?       @db.Decimal(4, 2)
  totalReviews Int?

  buckets RatingStarBucket[]
}

model RatingStarBucket {
  id               Int            @id @default(autoincrement())
  ratingSnapshotId Int
  ratingSnapshot   RatingSnapshot @relation(fields: [ratingSnapshotId], references: [id], onDelete: Cascade)
  stars            Int
  count            Int?
  percent          Decimal?       @db.Decimal(6, 2)

  @@unique([ratingSnapshotId, stars])
}

/// KPI: Closures. From Foody's operations tab; carries that section's status.
/// The reason breakdown is a child row table (like RatingStarBucket): the
/// portal's carousel shows one slide per reason that occurred, so absent rows
/// mean "didn't happen in the window", not "missing".
model ClosuresSnapshot {
  id                     Int            @id @default(autoincrement())
  snapshotId             Int            @unique
  snapshot               ScrapeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status                 SectionStatus
  offlineOpenHoursPct    Decimal?       @db.Decimal(6, 2)
  offlineDurationSeconds Int? // headline "2d 6h" -> 194400
  offlineDurationRaw     String? // original display string
  unreachableSeconds     Int? // "20m" -> 1200 (derived: "Unreachable" reason row)
  unreachableRaw         String? // original display string

  reasons ClosureReason[]
}

/// One slide of the closures reason carousel ("Closed", "Unreachable", …).
model ClosureReason {
  id                 Int              @id @default(autoincrement())
  closuresSnapshotId Int
  closuresSnapshot   ClosuresSnapshot @relation(fields: [closuresSnapshotId], references: [id], onDelete: Cascade)
  reason             String
  durationSeconds    Int? // "2d 2h" -> 180000
  durationRaw        String? // original display string

  @@index([closuresSnapshotId])
}

/// KPI: Punctuality. From Foody's operations tab.
model PunctualitySnapshot {
  id                      Int            @id @default(autoincrement())
  snapshotId              Int            @unique
  snapshot                ScrapeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status                  SectionStatus
  avoidableWaitOrdersPct  Decimal?       @db.Decimal(6, 2)
  deliveredOrders         Int?
  totalOrders             Int?
  avgAvoidableWaitSeconds Int? // "5:17" -> 317
  avgAvoidableWaitRaw     String? // "5:17"
}

/// KPI: Order rejections. From Foody's operations tab. The reason breakdown
/// is a child row table (see ClosuresSnapshot for the carousel semantics).
model OrderRejectionsSnapshot {
  id                 Int            @id @default(autoincrement())
  snapshotId         Int            @unique
  snapshot           ScrapeSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  status             SectionStatus
  cancellationsPct   Decimal?       @db.Decimal(6, 2)
  cancellationsCount Int? // headline count next to the percent, e.g. 15
  lostSales          Decimal?       @db.Decimal(12, 2)
  reasonUnknownCount Int? // derived: "Reason unknown" reason row

  reasons CancellationReason[]
}

/// One slide of the cancellations reason carousel ("Items Unavailable", …).
model CancellationReason {
  id                        Int                     @id @default(autoincrement())
  orderRejectionsSnapshotId Int
  orderRejectionsSnapshot   OrderRejectionsSnapshot @relation(fields: [orderRejectionsSnapshotId], references: [id], onDelete: Cascade)
  reason                    String
  cancellations             Int?
  salesLoss                 Decimal?                @db.Decimal(12, 2)
  salesLossRaw              String? // e.g. "€343.2 sales loss"

  @@index([orderRejectionsSnapshotId])
}

/// KPI: Reviews. A durable entity (NOT a snapshot): a review exists once per
/// store and is upserted across runs. `dedupeKey` is always non-null:
///   with an order id: "o:<orderId>"
///   without:          "h:" + sha256(rating|rawDate|comment)
/// which sidesteps Postgres treating NULLs as distinct in unique indexes.
model Review {
  id              Int       @id @default(autoincrement())
  storeId         Int
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalOrderId BigInt?
  dedupeKey       String
  rating          Int
  comment         String
  reviewedAt      DateTime? // parsed from "06/28/2026 • 03:07 PM" (portal wall time, stored as UTC face value)
  reviewedAtRaw   String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime
  orderDetails    Json? // full order behind the review (status/timeline/products/totals); null = not enriched yet
  orderScrapedAt  DateTime? // when orderDetails was last fetched

  @@unique([storeId, dedupeKey])
  @@index([storeId, rating])
  @@index([reviewedAt])
}
